# ────────────────────────────────────────────────────────────────────────
# Kenes — Environment Variables
# Copy this file to .env and fill in your own values.
# Never commit .env — it is in .gitignore.
# ────────────────────────────────────────────────────────────────────────

# ── Demo mode (no real credentials needed)
DEMO_MODE=true

# ── Supabase
# Create a project at https://supabase.com and get these from:
# Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── Anthropic / Claude
# Get from: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ── Poster POS (OAuth 2.0)
# Register your app at: https://dev.joinposter.com
POSTER_CLIENT_ID=your-poster-app-client-id
POSTER_CLIENT_SECRET=your-poster-app-secret
POSTER_REDIRECT_URI=http://localhost:3000/api/pos/poster/callback

# ── Token encryption
# Must be exactly 32 characters. Generate with:
# node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
ENCRYPTION_KEY=your-32-char-random-encryption-key

# ── Redis (BullMQ job queue)
# Upstash recommended: https://upstash.com
# Use rediss:// (TLS) for Upstash production
REDIS_URL=redis://localhost:6379

# ── App
FRONTEND_URL=http://localhost:5173
NODE_ENV=development
PORT=3000

# ── Reviews pipeline
CRON_SECRET=replace-with-random-cron-secret
CLAUDE_REVIEWS_THEMES_MODEL=claude-3-5-haiku-latest
CLAUDE_REVIEWS_SUGGESTIONS_MODEL=claude-3-7-sonnet-latest
